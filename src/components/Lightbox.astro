---
import { getLangFromCookie, t } from '../i18n';
const lang = getLangFromCookie(Astro.request.headers.get('cookie'));
---

<dialog 
  id="lightbox-dialog" 
  class="fixed inset-0 z-[100] m-auto w-full max-w-4xl p-0 bg-transparent backdrop:bg-black/75 backdrop:backdrop-blur-sm open:flex flex-col items-center justify-center focus:outline-none"
  aria-modal="true"
>
  <!-- Modal Content Container -->
  <div class="relative w-full max-h-[92vh] mx-4 sm:mx-auto bg-white dark:bg-zinc-900 rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-2xl overflow-hidden flex flex-col md:flex-row">
    
    <!-- Close Button Top Right -->
    <button 
      id="lightbox-close" 
      class="absolute top-4 right-4 z-20 p-2.5 rounded-full bg-zinc-100/80 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-600 dark:text-zinc-300 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500" 
      aria-label={t(lang, 'lightbox.close')}
      data-i18n-aria="lightbox.close"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- KOLOM KIRI: Foto Utama (Multi-Photo Swipe Slider) & Indikator Titik & Deretan Thumbnail -->
    <div class="w-full md:w-1/2 bg-zinc-100 dark:bg-zinc-950 p-5 sm:p-6 flex flex-col justify-between border-b md:border-b-0 md:border-r border-zinc-200 dark:border-zinc-800">
      
      <!-- Wadah Slider Foto Utama yang Bisa Diswipe -->
      <div 
        id="lightbox-viewport"
        class="relative w-full aspect-[4/5] sm:aspect-[3/4] max-h-[420px] rounded-2xl overflow-hidden bg-zinc-200/80 dark:bg-zinc-900/80 flex items-center justify-center group shadow-inner select-none"
      >
        <!-- Horizontal Scroll-Snap Slider Track (Touch Swipe di HP & Drag di Desktop) -->
        <div 
          id="lightbox-slider"
          class="w-full h-full flex overflow-x-auto snap-x snap-mandatory scrollbar-none scroll-smooth select-none cursor-grab active:cursor-grabbing"
        >
          <!-- Slides diisi secara dinamis via JS -->
        </div>

        <!-- Indikator Counter Foto -->
        <div class="absolute top-3 left-3 bg-zinc-900/80 backdrop-blur-md text-white text-xs px-3 py-1 rounded-full flex items-center gap-1.5 shadow-sm z-10 pointer-events-none">
          <span id="lightbox-counter">1 / 1</span>
        </div>

        <!-- Tombol Navigasi Prev/Next Foto -->
        <button 
          id="lightbox-prev" 
          type="button"
          class="absolute left-2 top-1/2 -translate-y-1/2 p-2 rounded-full bg-white/90 dark:bg-zinc-900/90 text-zinc-800 dark:text-zinc-200 shadow-md hover:bg-white dark:hover:bg-zinc-800 transition-colors focus:outline-none z-10"
          aria-label={t(lang, 'lightbox.prev')}
          data-i18n-aria="lightbox.prev"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>

        <button 
          id="lightbox-next" 
          type="button"
          class="absolute right-2 top-1/2 -translate-y-1/2 p-2 rounded-full bg-white/90 dark:bg-zinc-900/90 text-zinc-800 dark:text-zinc-200 shadow-md hover:bg-white dark:hover:bg-zinc-800 transition-colors focus:outline-none z-10"
          aria-label={t(lang, 'lightbox.next')}
          data-i18n-aria="lightbox.next"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>

      <!-- Indikator Titik (Pagination Dots) -->
      <div id="lightbox-dots-wrapper" class="flex items-center justify-center gap-1.5 mt-3 min-h-[14px]">
        <div id="lightbox-dots" class="flex items-center gap-1.5">
          <!-- Dots injected via JS -->
        </div>
      </div>

      <!-- Deretan Thumbnail Kecil (Multi-Foto) -->
      <div id="lightbox-thumbnails-wrapper" class="mt-2.5">
        <div id="lightbox-thumbnails" class="flex items-center gap-2.5 overflow-x-auto py-1 scrollbar-none">
          <!-- Thumbnail buttons injected via JS -->
        </div>
      </div>
    </div>

    <!-- KOLOM KANAN: Detail, Karakteristik & Aksi WhatsApp -->
    <div class="w-full md:w-1/2 p-6 sm:p-8 flex flex-col justify-between overflow-y-auto max-h-[500px] md:max-h-[600px]">
      <div class="space-y-5">
        
        <!-- Header Info: Kategori Pill dengan Warna Kontras Tinggi pada Mode Gelap -->
        <div class="flex items-center gap-2">
          <span 
            id="lightbox-badge-type" 
            class="text-xs uppercase tracking-wider font-bold px-3 py-1 rounded-full bg-rose-100 text-rose-800 dark:bg-rose-600 dark:text-white border border-rose-200 dark:border-rose-500 shadow-xs"
          >
            {t(lang, 'lightbox.fashionBadge')}
          </span>
          <span 
            id="lightbox-subcategory" 
            class="text-xs font-semibold px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700"
          >
            Subkategori
          </span>
        </div>

        <!-- Nama Produk -->
        <h2 
          id="lightbox-title" 
          class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white leading-tight font-serif"
        >
          Nama Produk
        </h2>

        <!-- Khusus Produk Busana/Pakaian: Kisaran Harga (Tepat di bawah judul produk dan sebelum deskripsi) -->
        <div id="lightbox-price-range-wrapper" class="hidden pt-0.5">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-zinc-100/90 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">
            <span class="text-xs font-medium text-zinc-600 dark:text-zinc-300" data-i18n="lightbox.modalPriceRangeLabel">
              {t(lang, 'lightbox.modalPriceRangeLabel')}
            </span>
            <span id="lightbox-price-range-value" class="text-sm font-bold text-zinc-900 dark:text-white tracking-tight">
              Rp... – Rp...
            </span>
          </div>
          <p class="text-[11px] text-zinc-400 dark:text-zinc-500 mt-1" data-i18n="lightbox.priceRangeNote">
            {t(lang, 'lightbox.priceRangeNote')}
          </p>
        </div>

        <!-- Blok DESKRIPSI (Tanpa Karakteristik & Tanpa Pill Status di Sebelahnya) -->
        <div class="p-4 sm:p-4.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/90 border border-zinc-200/80 dark:border-zinc-700/90 space-y-1.5">
          <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-800 dark:text-zinc-100" data-i18n="lightbox.descTitle">
            {t(lang, 'lightbox.descTitle')}
          </h4>
          <p 
            id="lightbox-desc" 
            class="text-sm sm:text-base text-zinc-700 dark:text-zinc-100 leading-relaxed font-normal whitespace-pre-line"
          >
            Deskripsi produk akan tampil di sini.
          </p>
        </div>

        <!-- Blok INFORMASI HARGA -->
        <div class="p-4 sm:p-4.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/90 border border-zinc-200/80 dark:border-zinc-700/90 space-y-1.5">
          <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-800 dark:text-zinc-100" data-i18n="lightbox.priceInfoTitle">
            {t(lang, 'lightbox.priceInfoTitle')}
          </h4>
          <p id="lightbox-price-info-desc" class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-200 leading-relaxed font-normal">
            {t(lang, 'lightbox.clothingPriceInfoDesc')}
          </p>
        </div>

        <!-- Kotak Info Ketersediaan Toko Fisik (Khusus Busana/Pakaian & Terikat i18n) -->
        <div id="lightbox-store-box" class="p-4 sm:p-4.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/90 border border-zinc-200/80 dark:border-zinc-700/90 space-y-1.5">
          <p id="lightbox-store-title" class="font-semibold text-zinc-900 dark:text-white text-sm" data-i18n="lightbox.clothingStoreTitle">
            {t(lang, 'lightbox.clothingStoreTitle')}
          </p>
          <p id="lightbox-store-note" class="text-zinc-600 dark:text-zinc-200 leading-relaxed text-xs sm:text-sm font-normal" data-i18n="lightbox.clothingStoreNote">
            {t(lang, 'lightbox.clothingStoreNote')}
          </p>
        </div>
      </div>

      <!-- Tombol Aksi WhatsApp Dinamis -->
      <div class="pt-6 mt-6 border-t border-zinc-100 dark:border-zinc-800">
        <a 
          id="lightbox-wa-btn" 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full inline-flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#20bd5a] text-white font-semibold px-6 py-3.5 rounded-xl shadow-md hover:shadow-lg transition-all min-h-[48px] text-sm sm:text-base"
        >
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span id="lightbox-wa-text">{t(lang, 'lightbox.inquireClothing')}</span>
        </a>
      </div>

    </div>
  </div>
</dialog>

<script is:inline>
(function() {
  const dialog = document.getElementById('lightbox-dialog');
  const slider = document.getElementById('lightbox-slider');
  const dotsContainer = document.getElementById('lightbox-dots');
  const dotsWrapper = document.getElementById('lightbox-dots-wrapper');
  const title = document.getElementById('lightbox-title');
  const desc = document.getElementById('lightbox-desc');
  const subcategory = document.getElementById('lightbox-subcategory');
  const badgeType = document.getElementById('lightbox-badge-type');
  const counter = document.getElementById('lightbox-counter');
  const waBtn = document.getElementById('lightbox-wa-btn');
  const waText = document.getElementById('lightbox-wa-text');
  const priceInfoDesc = document.getElementById('lightbox-price-info-desc');
  const storeBox = document.getElementById('lightbox-store-box');
  const storeTitle = document.getElementById('lightbox-store-title');
  const storeNote = document.getElementById('lightbox-store-note');
  const priceRangeWrapper = document.getElementById('lightbox-price-range-wrapper');
  const priceRangeValue = document.getElementById('lightbox-price-range-value');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  const thumbnailsContainer = document.getElementById('lightbox-thumbnails');
  const thumbnailsWrapper = document.getElementById('lightbox-thumbnails-wrapper');

  let images = [];
  let currentIndex = 0;
  let activeProductType = 'pakaian';
  let isDragging = false;
  let startX = 0;
  let startScrollLeft = 0;
  let hasDragged = false;

  function updateDynamicTexts() {
    const currentLang = localStorage.getItem('lang') || document.documentElement.lang || 'id';
    if (activeProductType === 'pakaian') {
      if (badgeType) {
        badgeType.textContent = window.getI18nText('lightbox.fashionBadge', currentLang);
        badgeType.className = 'text-xs uppercase tracking-wider font-bold px-3 py-1 rounded-full bg-rose-100 text-rose-800 dark:bg-rose-600 dark:text-white border border-rose-200 dark:border-rose-500 shadow-xs';
      }
      if (waText) waText.textContent = window.getI18nText('lightbox.inquireClothing', currentLang);
      if (priceInfoDesc) priceInfoDesc.textContent = window.getI18nText('lightbox.clothingPriceInfoDesc', currentLang);
      if (storeBox) storeBox.classList.remove('hidden');
      if (storeTitle) storeTitle.textContent = window.getI18nText('lightbox.clothingStoreTitle', currentLang);
      if (storeNote) storeNote.textContent = window.getI18nText('lightbox.clothingStoreNote', currentLang);
    } else {
      if (badgeType) {
        badgeType.textContent = window.getI18nText('lightbox.bouquetBadge', currentLang);
        badgeType.className = 'text-xs uppercase tracking-wider font-bold px-3 py-1 rounded-full bg-purple-100 text-purple-800 dark:bg-purple-600 dark:text-white border border-purple-200 dark:border-purple-500 shadow-xs';
      }
      if (waText) waText.textContent = window.getI18nText('lightbox.inquireBouquet', currentLang);
      if (priceInfoDesc) priceInfoDesc.textContent = window.getI18nText('lightbox.bouquetPriceInfoDesc', currentLang);
      if (storeBox) storeBox.classList.add('hidden');
    }
  }

  // Dengarkan event perubahan bahasa
  window.addEventListener('app:language-change', () => {
    updateDynamicTexts();
  });

  function renderGallery() {
    if (!slider) return;
    slider.innerHTML = '';
    if (dotsContainer) dotsContainer.innerHTML = '';
    if (thumbnailsContainer) thumbnailsContainer.innerHTML = '';

    const total = images.length;
    if (total <= 1) {
      if (dotsWrapper) dotsWrapper.style.display = 'none';
      if (thumbnailsWrapper) thumbnailsWrapper.style.display = 'none';
      if (prevBtn) prevBtn.style.display = 'none';
      if (nextBtn) nextBtn.style.display = 'none';
    } else {
      if (dotsWrapper) dotsWrapper.style.display = 'flex';
      if (thumbnailsWrapper) thumbnailsWrapper.style.display = 'block';
      if (prevBtn) prevBtn.style.display = 'flex';
      if (nextBtn) nextBtn.style.display = 'flex';
    }

    images.forEach((imgUrl, idx) => {
      // 1. Slide Image
      const slide = document.createElement('div');
      slide.className = 'w-full h-full flex-shrink-0 snap-center flex items-center justify-center p-2 sm:p-3 relative select-none';
      slide.innerHTML = `<img src="${imgUrl}" alt="Foto ${idx + 1}" class="max-w-full max-h-full object-contain pointer-events-none select-none rounded-xl transition-transform duration-300" />`;
      slider.appendChild(slide);

      // 2. Pagination Dot
      if (dotsContainer && total > 1) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = `lightbox-dot rounded-full transition-all duration-300 focus:outline-none ${
          idx === 0 ? 'w-5 h-2 bg-brand-500 dark:bg-brand-400' : 'w-2 h-2 bg-zinc-300 dark:bg-zinc-600 hover:bg-zinc-400'
        }`;
        dot.setAttribute('aria-label', `Foto ${idx + 1}`);
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          goToSlide(idx);
        });
        dotsContainer.appendChild(dot);
      }

      // 3. Thumbnail
      if (thumbnailsContainer && total > 1) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `w-14 h-14 rounded-lg overflow-hidden border-2 transition-all flex-shrink-0 ${
          idx === 0 ? 'border-brand-500 scale-105 shadow-sm' : 'border-transparent opacity-60 hover:opacity-100'
        }`;
        btn.innerHTML = `<img src="${imgUrl}" alt="Thumbnail ${idx + 1}" class="w-full h-full object-cover select-none pointer-events-none" />`;
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          goToSlide(idx);
        });
        thumbnailsContainer.appendChild(btn);
      }
    });

    updateActiveSlideUI();
  }

  function updateActiveSlideUI() {
    if (counter) {
      counter.textContent = `${currentIndex + 1} / ${Math.max(1, images.length)}`;
    }

    // Update Dots
    if (dotsContainer) {
      Array.from(dotsContainer.children).forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.className = 'lightbox-dot rounded-full transition-all duration-300 focus:outline-none w-5 h-2 bg-brand-500 dark:bg-brand-400';
        } else {
          dot.className = 'lightbox-dot rounded-full transition-all duration-300 focus:outline-none w-2 h-2 bg-zinc-300 dark:bg-zinc-600 hover:bg-zinc-400';
        }
      });
    }

    // Update Thumbnails
    if (thumbnailsContainer) {
      Array.from(thumbnailsContainer.children).forEach((thumb, idx) => {
        if (idx === currentIndex) {
          thumb.className = 'w-14 h-14 rounded-lg overflow-hidden border-2 border-brand-500 scale-105 shadow-sm flex-shrink-0 transition-all';
          thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          thumb.className = 'w-14 h-14 rounded-lg overflow-hidden border-2 border-transparent opacity-60 hover:opacity-100 flex-shrink-0 transition-all';
        }
      });
    }
  }

  function goToSlide(index) {
    if (!slider || !images.length) return;
    currentIndex = ((index % images.length) + images.length) % images.length;
    slider.scrollTo({
      left: currentIndex * slider.clientWidth,
      behavior: 'smooth'
    });
    updateActiveSlideUI();
  }

  // Touch Swipe & Scroll-Snap Sync
  let scrollDebounce = null;
  slider?.addEventListener('scroll', () => {
    if (!slider || !images.length) return;
    const width = slider.clientWidth;
    if (!width) return;
    const newIdx = Math.round(slider.scrollLeft / width);
    if (newIdx !== currentIndex && newIdx >= 0 && newIdx < images.length) {
      currentIndex = newIdx;
      clearTimeout(scrollDebounce);
      scrollDebounce = setTimeout(() => {
        updateActiveSlideUI();
      }, 50);
    }
  }, { passive: true });

  // Desktop Mouse Drag to Swipe
  slider?.addEventListener('mousedown', (e) => {
    if (images.length <= 1) return;
    isDragging = true;
    hasDragged = false;
    startX = e.pageX - slider.offsetLeft;
    startScrollLeft = slider.scrollLeft;
    slider.classList.remove('scroll-smooth');
  });

  window.addEventListener('mousemove', (e) => {
    if (!isDragging || !slider) return;
    const x = e.pageX - slider.offsetLeft;
    const walk = (x - startX);
    if (Math.abs(walk) > 5) hasDragged = true;
    slider.scrollLeft = startScrollLeft - walk;
  });

  window.addEventListener('mouseup', () => {
    if (!isDragging || !slider) return;
    isDragging = false;
    slider.classList.add('scroll-smooth');
    if (hasDragged) {
      const width = slider.clientWidth;
      const targetIndex = Math.round(slider.scrollLeft / width);
      goToSlide(targetIndex);
    }
  });

  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('[data-lightbox-trigger]');
    if (!trigger) return;

    try {
      images = JSON.parse(trigger.dataset.images || '[]');
    } catch {
      images = [];
    }
    if (!images || images.length === 0) {
      const fallbackImg = trigger.querySelector('img');
      if (fallbackImg && fallbackImg.src) {
        images = [fallbackImg.src];
      }
    }

    const itemTitle = trigger.dataset.title || 'Galeri Tik';
    const itemSubCat = trigger.dataset.subcategory || 'Koleksi';
    const itemDesc = trigger.dataset.description || '';
    activeProductType = trigger.dataset.type || 'pakaian';
    const itemWaUrl = trigger.dataset.waUrl || '#';
    const itemPriceRange = trigger.dataset.priceRange || '';

    if (title) title.textContent = itemTitle;
    if (desc) desc.textContent = itemDesc;
    if (subcategory) subcategory.textContent = itemSubCat;
    if (waBtn) waBtn.href = itemWaUrl;

    // Khusus Pakaian: Tampilkan Kisaran Harga jika tersedia
    if (activeProductType === 'pakaian' && itemPriceRange) {
      priceRangeWrapper?.classList.remove('hidden');
      if (priceRangeValue) priceRangeValue.textContent = itemPriceRange;
    } else {
      priceRangeWrapper?.classList.add('hidden');
    }

    updateDynamicTexts();

    currentIndex = 0;
    renderGallery();

    dialog.showModal();
    document.body.style.overflow = 'hidden';

    // Pastikan slider mulai dari slide pertama
    setTimeout(() => {
      if (slider) slider.scrollLeft = 0;
      updateActiveSlideUI();
    }, 50);
  });

  function closeDialog() {
    dialog.close();
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeDialog);
  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    goToSlide(currentIndex - 1);
  });
  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    goToSlide(currentIndex + 1);
  });

  dialog?.addEventListener('click', (e) => {
    const rect = dialog.getBoundingClientRect();
    const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
      rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
    if (!isInDialog || e.target === dialog) {
      closeDialog();
    }
  });

  dialog?.addEventListener('cancel', () => {
    document.body.style.overflow = '';
  });

  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'Escape') closeDialog();
    if (e.key === 'ArrowLeft') goToSlide(currentIndex - 1);
    if (e.key === 'ArrowRight') goToSlide(currentIndex + 1);
  });
})();
</script>

<style>
  dialog::backdrop {
    background: rgba(10, 10, 12, 0.78);
    backdrop-filter: blur(4px);
  }
  dialog[open] {
    animation: modalScaleIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes modalScaleIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
</style>
