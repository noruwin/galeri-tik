---
import { getLangFromCookie, t } from '../i18n';
const lang = getLangFromCookie(Astro.request.headers.get('cookie'));
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
---

<header class="sticky top-0 z-50 bg-white/90 dark:bg-zinc-950/90 backdrop-blur-md border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors duration-300">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo & Name: Font Khusus Khas & Eye Catching (Playfair Display / Serif) -->
      <a href="/" class="flex items-center gap-3.5 group focus:outline-none focus:ring-2 focus:ring-brand-500 rounded-full pr-2">
        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full overflow-hidden bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-300">
          <img
            src="/logo.png"
            alt="Galeri Tik"
            class="w-full h-full object-cover"
            onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-white font-serif font-bold text-lg\'>GT</span>';"
          />
        </div>
        <span class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white transition-colors group-hover:text-brand-600 dark:group-hover:text-brand-400 font-serif">
          Galeri Tik
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-8 text-sm font-medium">
        <a 
          href={isHome ? '#beranda' : '/'} 
          data-i18n="nav.home"
          class="text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white tracking-wide transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-500 hover:after:w-full after:transition-all"
        >
          {t(lang, 'nav.home')}
        </a>
        <a 
          href={isHome ? '#katalog-utama' : '/#katalog-utama'} 
          data-i18n="nav.clothing"
          class="text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white tracking-wide transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-500 hover:after:w-full after:transition-all"
          onclick="if (window.switchCatalogTab) { window.switchCatalogTab('pakaian'); }"
        >
          {t(lang, 'nav.clothing')}
        </a>
        <a 
          href={isHome ? '#katalog-utama' : '/#katalog-utama'} 
          data-i18n="nav.bouquet"
          class="text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white tracking-wide transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-500 hover:after:w-full after:transition-all"
          onclick="if (window.switchCatalogTab) { window.switchCatalogTab('buket'); }"
        >
          {t(lang, 'nav.bouquet')}
        </a>
        <a 
          href={isHome ? '#lokasi' : '/#lokasi'} 
          data-i18n="nav.location"
          class="text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white tracking-wide transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-500 hover:after:w-full after:transition-all"
        >
          {t(lang, 'nav.location')}
        </a>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2.5">
        <!-- Language Switcher: Seketika Berpindah & Tersimpan di localStorage -->
        <button 
          id="lang-toggle" 
          type="button"
          class="lang-toggle-btn px-3.5 py-1.5 text-xs font-semibold rounded-full border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-all min-w-[44px] min-h-[44px] flex items-center justify-center tracking-wider select-none cursor-pointer" 
          aria-label="Switch language"
        >
          {t(lang, 'language.switch')}
        </button>

        <!-- Theme Toggle -->
        <button 
          id="theme-toggle" 
          type="button"
          class="p-2.5 rounded-full border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-all min-w-[44px] min-h-[44px] flex items-center justify-center" 
          aria-label="Toggle theme"
        >
          <svg class="w-4 h-4 hidden dark:block text-amber-300" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/>
          </svg>
          <svg class="w-4 h-4 block dark:hidden text-zinc-700" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
          </svg>
        </button>

        <!-- Mobile Menu Button -->
        <button 
          id="mobile-menu-btn" 
          type="button"
          class="md:hidden p-2.5 rounded-full border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center" 
          aria-label="Open menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav Dropdown -->
    <div id="mobile-menu" class="md:hidden hidden pb-5 border-t border-zinc-200 dark:border-zinc-800 mt-2 pt-3">
      <div class="flex flex-col gap-2">
        <a href={isHome ? '#beranda' : '/'} data-i18n="nav.home" class="text-sm font-medium text-zinc-700 dark:text-zinc-200 hover:text-brand-600 dark:hover:text-brand-400 py-2.5 px-3 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors">{t(lang, 'nav.home')}</a>
        <a href={isHome ? '#katalog-utama' : '/#katalog-utama'} data-i18n="nav.clothing" onclick="if(window.switchCatalogTab){window.switchCatalogTab('pakaian');} document.getElementById('mobile-menu').classList.add('hidden');" class="text-sm font-medium text-zinc-700 dark:text-zinc-200 hover:text-brand-600 dark:hover:text-brand-400 py-2.5 px-3 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors">{t(lang, 'nav.clothing')}</a>
        <a href={isHome ? '#katalog-utama' : '/#katalog-utama'} data-i18n="nav.bouquet" onclick="if(window.switchCatalogTab){window.switchCatalogTab('buket');} document.getElementById('mobile-menu').classList.add('hidden');" class="text-sm font-medium text-zinc-700 dark:text-zinc-200 hover:text-brand-600 dark:hover:text-brand-400 py-2.5 px-3 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors">{t(lang, 'nav.bouquet')}</a>
        <a href={isHome ? '#lokasi' : '/#lokasi'} data-i18n="nav.location" onclick="document.getElementById('mobile-menu').classList.add('hidden');" class="text-sm font-medium text-zinc-700 dark:text-zinc-200 hover:text-brand-600 dark:hover:text-brand-400 py-2.5 px-3 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors">{t(lang, 'nav.location')}</a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  // Theme toggle
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
  });

  // Language toggle seketika (Instant Switch tanpa reload)
  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    const currentLang = localStorage.getItem('lang') || document.documentElement.lang || 'id';
    const nextLang = (currentLang === 'id') ? 'en' : 'id';
    if (window.setAppLanguage) {
      window.setAppLanguage(nextLang);
    }
  });

  // Mobile menu toggle
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
