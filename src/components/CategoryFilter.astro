---
import { getLangFromCookie, t } from '../i18n';

interface Props {
  categories: string[];
}

const lang = getLangFromCookie(Astro.request.headers.get('cookie'));
const { categories } = Astro.props;
---

<div class="flex flex-wrap gap-2" id="category-filters">
  <button
    data-category="all"
    data-i18n="categories.all"
    class="category-btn active px-4 py-2 rounded-full text-sm font-bold border transition-all min-h-[44px] bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 border-zinc-900 dark:border-white shadow-xs"
  >
    {t(lang, 'categories.all')}
  </button>
  {categories.map((cat) => (
    <button
      data-category={cat}
      class="category-btn px-4 py-2 rounded-full text-sm font-semibold border transition-all min-h-[44px] bg-white dark:bg-zinc-800 text-zinc-800 dark:text-zinc-100 border-zinc-200 dark:border-zinc-700 hover:border-zinc-400 dark:hover:border-zinc-500 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-50 dark:hover:bg-zinc-700 shadow-xs"
    >
      {cat}
    </button>
  ))}
</div>

<script is:inline>
(function() {
  const filters = document.getElementById('category-filters');
  if (!filters) return;

  filters.addEventListener('click', (e) => {
    const btn = e.target.closest('.category-btn');
    if (!btn) return;

    // Update active state visually
    filters.querySelectorAll('.category-btn').forEach(b => {
      b.classList.remove('bg-zinc-900', 'text-white', 'border-zinc-900', 'dark:bg-white', 'dark:text-zinc-900', 'dark:border-white', 'font-bold');
      b.classList.add('bg-white', 'dark:bg-zinc-800', 'text-zinc-800', 'dark:text-zinc-100', 'border-zinc-200', 'dark:border-zinc-700', 'font-semibold');
    });
    btn.classList.add('bg-zinc-900', 'text-white', 'border-zinc-900', 'dark:bg-white', 'dark:text-zinc-900', 'dark:border-white', 'font-bold');
    btn.classList.remove('bg-white', 'dark:bg-zinc-800', 'text-zinc-800', 'dark:text-zinc-100', 'border-zinc-200', 'dark:border-zinc-700');

    const category = btn.dataset.category;
    
    // Filter cards
    document.querySelectorAll('[data-sub-category]').forEach(card => {
      if (category === 'all' || card.dataset.subCategory === category) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });

    // Check if any visible
    const grid = document.getElementById('product-grid');
    const noResults = document.getElementById('no-results');
    if (grid && noResults) {
      const visibleCards = grid.querySelectorAll('[data-sub-category]:not([style*="display: none"])');
      noResults.style.display = visibleCards.length === 0 ? 'block' : 'none';
    }
  });
})();
</script>
