---
import { getLangFromCookie, t } from '../i18n';
import { STORE_CONFIG } from '../lib/constants';
import { getGeneralWhatsAppUrl } from '../lib/whatsapp';

const lang = getLangFromCookie(Astro.request.headers.get('cookie'));
const waUrl = getGeneralWhatsAppUrl();
---

<footer class="bg-zinc-950 text-zinc-300 border-t border-zinc-850 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12 pb-12 border-b border-zinc-850">
      
      <!-- Kolom 1: Logo, Nama & Profil Toko (5 Kolom, Tanpa Info Toko Buka / Pill Hijau) -->
      <div class="md:col-span-5 space-y-4">
        <a href="/" class="flex items-center gap-3.5 group inline-flex focus:outline-none">
          <div class="w-11 h-11 rounded-full overflow-hidden bg-zinc-900 border border-zinc-700 shadow-sm flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
            <img 
              src="/logo.png" 
              alt="Galeri Tik" 
              class="w-full h-full object-cover"
              onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-white font-serif font-bold text-sm\'>GT</span>';"
            />
          </div>
          <span class="text-2xl font-bold tracking-tight text-white font-serif">
            Galeri Tik
          </span>
        </a>
        
        <p class="text-sm text-zinc-400 leading-relaxed font-normal max-w-sm" data-i18n="footer.desc">
          {t(lang, 'footer.desc')}
        </p>
      </div>

      <!-- Kolom 2: Menu Tautan Cepat (3 Kolom) -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-zinc-400" data-i18n="footer.quickLinks">
          {t(lang, 'footer.quickLinks')}
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/#beranda" data-i18n="nav.home" class="text-zinc-400 hover:text-white transition-colors">
              {t(lang, 'nav.home')}
            </a>
          </li>
          <li>
            <a href="/#katalog-utama" data-i18n="nav.clothing" onclick="if(window.switchCatalogTab){window.switchCatalogTab('pakaian');}" class="text-zinc-400 hover:text-white transition-colors">
              {t(lang, 'nav.clothing')}
            </a>
          </li>
          <li>
            <a href="/#katalog-utama" data-i18n="nav.bouquet" onclick="if(window.switchCatalogTab){window.switchCatalogTab('buket');}" class="text-zinc-400 hover:text-white transition-colors">
              {t(lang, 'nav.bouquet')}
            </a>
          </li>
          <li>
            <a href="/#lokasi" data-i18n="nav.location" class="text-zinc-400 hover:text-white transition-colors">
              {t(lang, 'nav.location')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Kolom 3: Kontak Langsung & Pemilik (4 Kolom) -->
      <div class="md:col-span-4 space-y-3.5">
        <h4 class="text-xs font-bold uppercase tracking-widest text-zinc-400" data-i18n="footer.directContact">
          {t(lang, 'footer.directContact')}
        </h4>
        
        <div class="space-y-2 text-sm text-zinc-400">
          <p class="flex items-center gap-2">
            <span class="text-zinc-400 font-medium" data-i18n="footer.owner">{t(lang, 'footer.owner')}</span>
            <span class="text-zinc-200 font-semibold">Ibu Tik</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-zinc-400 font-medium" data-i18n="footer.whatsapp">{t(lang, 'footer.whatsapp')}</span>
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-200 hover:text-brand-400 transition-colors font-mono">
              +62 822-9984-2236
            </a>
          </p>
          <p class="text-xs leading-relaxed text-zinc-400">
            {STORE_CONFIG.address}
          </p>
        </div>

        <div class="pt-2">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-zinc-900 hover:bg-zinc-850 text-emerald-400 border border-zinc-800 hover:border-emerald-500/50 text-xs font-semibold px-4 py-2.5 rounded-xl transition-all hover:-translate-y-0.5"
          >
            <svg class="w-4 h-4 flex-shrink-0 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span data-i18n="footer.chatWhatsApp">{t(lang, 'footer.chatWhatsApp')}</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-400 gap-4">
      <p data-i18n="footer.copyright">{t(lang, 'footer.copyright')}</p>
      <p class="text-zinc-400" data-i18n="footer.tagline">{t(lang, 'footer.tagline')}</p>
    </div>

  </div>
</footer>
