---
import { getLangFromCookie, t } from '../i18n';
import { STORE_CONFIG } from '../lib/constants';
import { getGeneralWhatsAppUrl } from '../lib/whatsapp';

const lang = getLangFromCookie(Astro.request.headers.get('cookie'));
const waUrl = getGeneralWhatsAppUrl();
---

<section id="lokasi" class="py-16 sm:py-20 bg-gray-50 dark:bg-gray-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl sm:text-3xl font-bold text-center mb-10 text-gray-900 dark:text-white">
      📍 {t(lang, 'store.title')}
    </h2>
    
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Map -->
      <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-200 dark:border-gray-700 h-[300px] sm:h-[400px]">
        <iframe
          src={STORE_CONFIG.mapsEmbed}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Lokasi Galeri Tik"
        ></iframe>
      </div>

      <!-- Info -->
      <div class="flex flex-col justify-center gap-6">
        <div>
          <h3 class="font-semibold text-gray-500 dark:text-gray-400 text-sm uppercase tracking-wider mb-2">{t(lang, 'store.address')}</h3>
          <p class="text-lg text-gray-900 dark:text-white">{STORE_CONFIG.address}</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-500 dark:text-gray-400 text-sm uppercase tracking-wider mb-2">{t(lang, 'store.hours')}</h3>
          <p class="text-lg text-gray-900 dark:text-white">{t(lang, 'store.hoursValue')}</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 mt-2">
          <a
            href={STORE_CONFIG.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-xl transition-colors min-h-[48px]"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            {t(lang, 'store.visitMap')}
          </a>
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20bd5a] text-white font-semibold px-6 py-3 rounded-xl transition-colors min-h-[48px]"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            {t(lang, 'store.contact')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
