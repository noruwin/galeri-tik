---
import { getLangFromCookie, t } from '../i18n';
import { STORE_CONFIG } from '../lib/constants';
import { getGeneralWhatsAppUrl } from '../lib/whatsapp';

const lang = getLangFromCookie(Astro.request.headers.get('cookie'));
const waUrl = getGeneralWhatsAppUrl();
---

<section id="lokasi" class="py-16 sm:py-24 bg-white dark:bg-zinc-950 border-t border-zinc-200/80 dark:border-zinc-850">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Tanpa Emoji) Terikat i18n -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400" data-i18n="store.badge">
        {t(lang, 'store.badge')}
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-2 tracking-tight font-serif" data-i18n="store.title">
        {t(lang, 'store.title')}
      </h2>
      <p class="text-sm sm:text-base text-zinc-500 dark:text-zinc-400 mt-3 font-normal" data-i18n="store.subtitle">
        {t(lang, 'store.subtitle')}
      </p>
    </div>
    
    <div class="grid lg:grid-cols-12 gap-8 items-start">
      
      <!-- Peta Google Maps Embed (7 Kolom) -->
      <div class="lg:col-span-7 rounded-2xl overflow-hidden shadow-sm border border-zinc-200 dark:border-zinc-800 h-[340px] sm:h-[420px] bg-zinc-100 dark:bg-zinc-900">
        <iframe
          src={STORE_CONFIG.mapsEmbed}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Lokasi Toko Fisik Galeri Tik"
        ></iframe>
      </div>

      <!-- Informasi Alamat, Jam Operasional & Fasilitas Toko (5 Kolom) -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
        
        <!-- Alamat & Jam -->
        <div class="space-y-4">
          <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/70 border border-zinc-200/70 dark:border-zinc-800">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1" data-i18n="store.addressLabel">
              {t(lang, 'store.addressLabel')}
            </h3>
            <p class="text-sm sm:text-base font-medium text-zinc-800 dark:text-zinc-200 leading-relaxed">
              {STORE_CONFIG.address}
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/70 border border-zinc-200/70 dark:border-zinc-800">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1" data-i18n="store.hoursLabel">
              {t(lang, 'store.hoursLabel')}
            </h3>
            <p class="text-sm sm:text-base font-semibold text-zinc-900 dark:text-white">
              {STORE_CONFIG.hours}
            </p>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1" data-i18n="store.hoursNote">
              {t(lang, 'store.hoursNote')}
            </p>
          </div>
        </div>

        <!-- Fasilitas Toko & Metode Pembayaran: Bebas dari Semua Simbol dan Emoji -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Fasilitas Kamar Pas (Tanpa Simbol/Emoji) -->
          <div class="p-5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800">
            <h4 class="text-sm font-bold text-zinc-900 dark:text-white" data-i18n="store.fittingTitle">
              {t(lang, 'store.fittingTitle')}
            </h4>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1.5 leading-relaxed font-normal" data-i18n="store.fittingDesc">
              {t(lang, 'store.fittingDesc')}
            </p>
          </div>

          <!-- Opsi Pembayaran (Tanpa Simbol/Emoji) -->
          <div class="p-5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800">
            <h4 class="text-sm font-bold text-zinc-900 dark:text-white" data-i18n="store.paymentTitle">
              {t(lang, 'store.paymentTitle')}
            </h4>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1.5 leading-relaxed font-normal" data-i18n="store.paymentDesc">
              {t(lang, 'store.paymentDesc')}
            </p>
          </div>
        </div>

        <!-- Tombol Aksi Navigasi & Kontak -->
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a
            href={STORE_CONFIG.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center gap-2.5 bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-900 font-semibold px-5 py-3.5 rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-md min-h-[48px] text-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span data-i18n="store.visitMap">{t(lang, 'store.visitMap')}</span>
          </a>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#20bd5a] text-white font-semibold px-5 py-3.5 rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-md min-h-[48px] text-sm"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span data-i18n="store.contact">{t(lang, 'store.contact')}</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
