---
interface Props {
  brands: string[];
}
const { brands } = Astro.props;
// Duplicate for seamless infinite loop
const displayBrands = [...brands, ...brands, ...brands];
---

<div class="bg-zinc-900 border-y border-zinc-800 text-zinc-200 py-3 overflow-hidden relative select-none">
  <div class="animate-marquee whitespace-nowrap flex items-center">
    {displayBrands.map((brand) => (
      <span class="inline-flex items-center text-xs sm:text-sm font-medium tracking-widest uppercase text-zinc-300">
        <span class="px-5 sm:px-8 hover:text-white transition-colors">{brand}</span>
        <span class="text-zinc-600 font-light select-none" aria-hidden="true">|</span>
      </span>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }
  .animate-marquee {
    animation: marquee 35s linear infinite;
    width: max-content;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>
