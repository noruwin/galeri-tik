---
interface Props {
  brands: string[];
}
const { brands } = Astro.props;
// Duplicate for seamless loop
const displayBrands = [...brands, ...brands];
---

<div class="bg-brand-500 dark:bg-brand-700 text-white py-3 overflow-hidden relative">
  <div class="animate-marquee whitespace-nowrap flex items-center">
    {displayBrands.map((brand) => (
      <span class="mx-8 text-sm sm:text-base font-semibold tracking-wide inline-flex items-center gap-3">
        <span class="w-1.5 h-1.5 bg-white rounded-full opacity-70"></span>
        {brand}
      </span>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 30s linear infinite;
    width: max-content;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>
