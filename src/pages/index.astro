---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import BouquetEducation from '../components/BouquetEducation.astro';
import ProductCard from '../components/ProductCard.astro';
import StoreInfo from '../components/StoreInfo.astro';
import WhatsAppFAB from '../components/WhatsAppFAB.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { supabase } from '../lib/supabase';
import { getLangFromCookie, t } from '../i18n';

const lang = getLangFromCookie(Astro.request.headers.get('cookie'));

// Fetch brands for marquee
const { data: brands } = await supabase
  .from('brands_ticker')
  .select('brand_name')
  .eq('is_active', true)
  .order('display_order', { ascending: true });

const brandNames = brands?.map(b => b.brand_name) || [
  'Zara', 'Nevada', 'Produk Impor', 'Koleksi Lokal Pilihan', 'Aksesoris Mode', 'Koleksi Terbaru'
];

// Fetch categories
const { data: categories } = await supabase
  .from('categories')
  .select('*');

const pakaianCategory = categories?.find(c => c.slug === 'pakaian');
const buketCategory = categories?.find(c => c.slug === 'buket');

// Fetch featured products
const { data: featuredPakaian } = await supabase
  .from('products')
  .select('*')
  .eq('category_id', pakaianCategory?.id || '')
  .eq('is_featured', true)
  .limit(6);

const { data: featuredBuket } = await supabase
  .from('products')
  .select('*')
  .eq('category_id', buketCategory?.id || '')
  .eq('is_featured', true)
  .limit(6);
---

<BaseLayout>
  <Header />
  
  <!-- Brand Marquee -->
  <BrandMarquee brands={brandNames} />

  <!-- Hero Section -->
  <section id="beranda" class="py-16 sm:py-24 bg-gradient-to-b from-pink-50/50 to-white dark:from-gray-900 dark:to-gray-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 dark:text-white leading-tight mb-6">
        {t(lang, 'hero.title').split('Galeri Tik')[0]}
        <span class="text-brand-500">Galeri Tik</span>
      </h1>
      <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-10">
        {t(lang, 'hero.subtitle')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/pakaian" class="inline-flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-semibold px-8 py-4 rounded-xl text-lg transition-colors min-h-[52px] shadow-lg shadow-brand-500/25">
          👗 {t(lang, 'nav.clothing')}
        </a>
        <a href="/buket" class="inline-flex items-center justify-center gap-2 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-white font-semibold px-8 py-4 rounded-xl text-lg transition-colors min-h-[52px] border border-gray-200 dark:border-gray-700 shadow-sm">
          💐 {t(lang, 'nav.bouquet')}
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Clothing -->
  {(featuredPakaian && featuredPakaian.length > 0) && (
    <section class="py-16 sm:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">
            👗 {t(lang, 'nav.clothing')}
          </h2>
          <a href="/pakaian" class="text-brand-500 hover:text-brand-600 font-semibold text-sm sm:text-base flex items-center gap-1 group">
            {t(lang, 'product.viewAllClothing')}
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4 sm:gap-6">
          {featuredPakaian.map((product) => (
            <ProductCard product={product} type="pakaian" lang={lang} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Bouquet Education Banner -->
  <section class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <BouquetEducation />
    </div>
  </section>

  <!-- Featured Bouquets -->
  {(featuredBuket && featuredBuket.length > 0) && (
    <section class="py-16 sm:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">
            💐 {t(lang, 'nav.bouquet')}
          </h2>
          <a href="/buket" class="text-brand-500 hover:text-brand-600 font-semibold text-sm sm:text-base flex items-center gap-1 group">
            {t(lang, 'product.viewAllBouquet')}
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4 sm:gap-6">
          {featuredBuket.map((product) => (
            <ProductCard product={product} type="buket" lang={lang} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Store Info & Location -->
  <StoreInfo />

  <!-- Footer -->
  <Footer />

  <!-- Lightbox -->
  <Lightbox />

  <!-- WhatsApp FAB -->
  <WhatsAppFAB />
</BaseLayout>
