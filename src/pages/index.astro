---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import BouquetEducation from '../components/BouquetEducation.astro';
import ProductCard from '../components/ProductCard.astro';
import StoreInfo from '../components/StoreInfo.astro';
import WhatsAppFAB from '../components/WhatsAppFAB.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { supabase } from '../lib/supabase';
import { getLangFromCookie, t } from '../i18n';

const lang = getLangFromCookie(Astro.request.headers.get('cookie'));

// Fetch brands for marquee
const { data: brands } = await supabase
  .from('brands_ticker')
  .select('brand_name')
  .eq('is_active', true)
  .order('display_order', { ascending: true });

const brandNames = brands?.map(b => b.brand_name) || [
  'Zara', 'Nevada', 'Produk Impor', 'Koleksi Lokal Pilihan', 'Aksesoris Mode', 'Koleksi Terbaru'
];

// Fetch dynamic clothing types from Supabase
const { data: dbClothingTypes } = await supabase
  .from('clothing_types')
  .select('name')
  .eq('is_active', true)
  .order('display_order', { ascending: true });

const clothingTypes = dbClothingTypes?.map(t => t.name) || [
  'Gamis', 'Daster', 'Kulot', 'Rok', 'Celana', 'Koko', 'Kemeja', 'Kaos', 'Tas', 'Bros'
];

// Fetch all pakaian products from dedicated clothing_products table
const { data: pakaianProducts } = await supabase
  .from('clothing_products')
  .select('*')
  .order('created_at', { ascending: false });

// Fetch all buket products from dedicated bouquet_products table
const { data: buketProducts } = await supabase
  .from('bouquet_products')
  .select('*')
  .order('created_at', { ascending: false });

const allPakaian = pakaianProducts || [];
const allBuket = buketProducts || [];

const featuredPakaian = allPakaian.filter(p => p.is_featured);
const featuredBuket = allBuket.filter(p => p.is_featured);
---

<BaseLayout>
  <Header />
  
  <!-- Marquee Ticker: Gelap Elegan Charcoal dengan Pemisah Garis Vertikal | -->
  <BrandMarquee brands={brandNames} />

  <!-- Hero Section (Layer Dasar / Sticky Background) -->
  <section id="beranda" class="sticky top-0 w-full h-[82vh] md:h-[88vh] z-0 overflow-hidden flex flex-col justify-center bg-[#FAF8F5] dark:bg-[#161514]">
    
    <!-- Layer Background Gambar Responsif (z-0) -->
    <div class="absolute inset-0 z-0 select-none pointer-events-none">
      <!-- Versi Mobile (< 768px): hero-bg-mobile.jpg (kunci posisi ke kanan atas) -->
      <img 
        src="/hero-bg-mobile.jpg" 
        alt="Galeri Tik Hero Background Mobile" 
        class="block md:hidden object-cover object-[80%_25%] w-full h-full"
      />
      <!-- Versi Desktop (>= 768px): hero-bg.jpg -->
      <img 
        src="/hero-bg.jpg" 
        alt="Galeri Tik Hero Background Desktop" 
        class="hidden md:block object-cover object-right sm:object-center w-full h-full"
      />
    </div>

    <!-- Lapisan Gradasi Overlay Mask (z-10) -->
    <!-- Versi Mobile (< 768px): Gradasi Padat & Backdrop Blur Lembut -->
    <div 
      class="absolute inset-0 z-10 pointer-events-none block md:hidden bg-[linear-gradient(to_bottom,rgba(250,248,245,0.95)_0%,rgba(250,248,245,0.85)_45%,rgba(250,248,245,0.5)_65%,transparent_100%)] dark:bg-[linear-gradient(to_bottom,rgba(22,21,20,0.95)_0%,rgba(22,21,20,0.85)_45%,rgba(22,21,20,0.5)_65%,transparent_100%)] backdrop-blur-[2px] [mask-image:linear-gradient(to_bottom,black_65%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,black_65%,transparent_100%)]"
      aria-hidden="true"
    ></div>
    <!-- Versi Desktop (>= 768px): Gradasi Horizontal dari Kiri -->
    <div 
      class="hidden md:block absolute inset-0 z-10 bg-gradient-to-r from-[#FAF8F5] via-[#FAF8F5]/80 to-transparent dark:from-[#161514] dark:via-[#161514]/80 dark:to-transparent pointer-events-none"
      aria-hidden="true"
    ></div>

    <!-- Konten Teks Hero (z-20 relative, Rata Kiri Murni) -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="flex flex-col items-start text-left max-w-2xl lg:max-w-3xl">
        
        <!-- Headline: Font Serif Berkarakter Katalog/Editorial yang Tegas (Rata Kiri, Ekstra Tebal & Berbayang di Mobile) -->
        <h1 
          class="text-3xl sm:text-5xl lg:text-6xl font-extrabold md:font-bold text-zinc-900 dark:text-white leading-[1.18] tracking-tight font-serif mb-4 sm:mb-6 text-left drop-shadow-[0_2px_4px_rgba(255,255,255,0.8)] dark:drop-shadow-[0_2px_6px_rgba(0,0,0,0.95)] md:drop-shadow-none"
          data-i18n="hero.headline"
        >
          {t(lang, 'hero.headline')}
        </h1>

        <!-- Deskripsi: Paragraf singkat rata kiri dengan warna tegas & line-height renggang -->
        <p 
          class="text-base sm:text-lg lg:text-xl text-stone-900 dark:text-stone-100 font-semibold md:font-medium leading-relaxed max-w-xl mb-6 sm:mb-8 text-left drop-shadow-[0_1px_3px_rgba(255,255,255,0.8)] dark:drop-shadow-[0_1px_4px_rgba(0,0,0,0.9)] md:drop-shadow-none"
          data-i18n="hero.subtitle"
        >
          {t(lang, 'hero.subtitle')}
        </p>

        <!-- Tombol Aksi: Dua tombol berdampingan secara horizontal di bawah deskripsi -->
        <div class="flex flex-row gap-3 sm:gap-4 flex-wrap items-center">
          <a 
            href="#katalog-utama" 
            onclick="if(window.switchCatalogTab){window.switchCatalogTab('pakaian');}"
            class="inline-flex items-center justify-center gap-2 bg-zinc-900 hover:bg-zinc-800 dark:bg-white dark:hover:bg-zinc-100 text-white dark:text-zinc-900 font-semibold px-6 py-3 sm:px-8 sm:py-4 rounded-xl text-sm sm:text-base border border-zinc-900 dark:border-white shadow-md hover:-translate-y-1 hover:shadow-xl active:scale-95 active:bg-rose-600 active:border-rose-600 active:text-white dark:active:bg-rose-600 dark:active:border-rose-600 dark:active:text-white transition-all duration-300 ease-out min-h-[46px] group"
          >
            <span data-i18n="hero.exploreClothing">{t(lang, 'hero.exploreClothing')}</span>
            <svg class="w-4 h-4 transform group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>

          <a 
            href="#katalog-utama" 
            onclick="if(window.switchCatalogTab){window.switchCatalogTab('buket');}"
            class="inline-flex items-center justify-center gap-2 bg-zinc-900 hover:bg-zinc-800 dark:bg-white dark:hover:bg-zinc-100 text-white dark:text-zinc-900 font-semibold px-6 py-3 sm:px-8 sm:py-4 rounded-xl text-sm sm:text-base border border-zinc-900 dark:border-white shadow-md hover:-translate-y-1 hover:shadow-xl active:scale-95 active:bg-purple-600 active:border-purple-600 active:text-white dark:active:bg-purple-600 dark:active:border-purple-600 dark:active:text-white transition-all duration-300 ease-out min-h-[46px] group"
          >
            <span data-i18n="hero.viewBouquetGallery">{t(lang, 'hero.viewBouquetGallery')}</span>
            <svg class="w-4 h-4 transform group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lembar Konten Meluncur (Overlapping Content Sheet) -->
  <div class="relative z-10 w-full bg-[#FAF8F5] dark:bg-[#161514] rounded-t-[32px] md:rounded-t-[48px] shadow-[0_-25px_50px_-12px_rgba(0,0,0,0.12)] dark:shadow-[0_-25px_50px_-12px_rgba(0,0,0,0.5)] pt-8 md:pt-12">
    
    <!-- Penataan 4 Kotak Fitur (Sebagai Pembuka Lembar Overlap) -->
    <div 
      id="store-features-container"
      class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 md:mb-12"
    >
      <!-- Fitur 1: 100% Produk Baru (Aksen Rose/Pink) -->
      <div 
        class="feature-interactive-card bg-zinc-900 dark:bg-white border border-zinc-800 dark:border-white rounded-2xl p-4 sm:p-5 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300 cursor-pointer select-none text-center flex flex-col items-center justify-start h-full group"
        data-feature-color="rose"
      >
        <h3 class="font-bold text-white dark:text-zinc-900 text-sm sm:text-base tracking-tight transition-colors group-hover:text-rose-400 dark:group-hover:text-rose-600" data-i18n="features.newProductTitle">
          {t(lang, 'features.newProductTitle')}
        </h3>
        <p class="text-xs sm:text-sm text-zinc-400 dark:text-zinc-600 mt-1.5 leading-relaxed font-normal" data-i18n="features.newProductDesc">
          {t(lang, 'features.newProductDesc')}
        </p>
      </div>

      <!-- Fitur 2: Harga Bersahabat (Aksen Purple/Violet) -->
      <div 
        class="feature-interactive-card bg-zinc-900 dark:bg-white border border-zinc-800 dark:border-white rounded-2xl p-4 sm:p-5 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300 cursor-pointer select-none text-center flex flex-col items-center justify-start h-full group"
        data-feature-color="purple"
      >
        <h3 class="font-bold text-white dark:text-zinc-900 text-sm sm:text-base tracking-tight transition-colors group-hover:text-purple-400 dark:group-hover:text-purple-600" data-i18n="features.affordablePriceTitle">
          {t(lang, 'features.affordablePriceTitle')}
        </h3>
        <p class="text-xs sm:text-sm text-zinc-400 dark:text-zinc-600 mt-1.5 leading-relaxed font-normal" data-i18n="features.affordablePriceDesc">
          {t(lang, 'features.affordablePriceDesc')}
        </p>
      </div>

      <!-- Fitur 3: Pilihan Busana Beragam (Aksen Sky/Blue) -->
      <div 
        class="feature-interactive-card bg-zinc-900 dark:bg-white border border-zinc-800 dark:border-white rounded-2xl p-4 sm:p-5 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300 cursor-pointer select-none text-center flex flex-col items-center justify-start h-full group"
        data-feature-color="sky"
      >
        <h3 class="font-bold text-white dark:text-zinc-900 text-sm sm:text-base tracking-tight transition-colors group-hover:text-sky-400 dark:group-hover:text-sky-600" data-i18n="features.diverseClothingTitle">
          {t(lang, 'features.diverseClothingTitle')}
        </h3>
        <p class="text-xs sm:text-sm text-zinc-400 dark:text-zinc-600 mt-1.5 leading-relaxed font-normal" data-i18n="features.diverseClothingDesc">
          {t(lang, 'features.diverseClothingDesc')}
        </p>
      </div>

      <!-- Fitur 4: Buket Custom (Aksen Emerald/Teal) -->
      <div 
        class="feature-interactive-card bg-zinc-900 dark:bg-white border border-zinc-800 dark:border-white rounded-2xl p-4 sm:p-5 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300 cursor-pointer select-none text-center flex flex-col items-center justify-start h-full group"
        data-feature-color="emerald"
      >
        <h3 class="font-bold text-white dark:text-zinc-900 text-sm sm:text-base tracking-tight transition-colors group-hover:text-emerald-400 dark:group-hover:text-emerald-600" data-i18n="features.customBouquetTitle">
          {t(lang, 'features.customBouquetTitle')}
        </h3>
        <p class="text-xs sm:text-sm text-zinc-400 dark:text-zinc-600 mt-1.5 leading-relaxed font-normal" data-i18n="features.customBouquetDesc">
          {t(lang, 'features.customBouquetDesc')}
        </p>
      </div>
    </div>

    <!-- SEKSI UTAMA: Tab Switcher Terpadu & Pencarian Global (Terikat i18n) -->
    <section 
      id="katalog-utama" 
      class="scroll-mt-20 pb-12 sm:pb-16"
    >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Bar Kontrol Terpadu: Kiri Tab Switcher, Kanan Input Pencarian Global -->
      <div class="bg-white dark:bg-zinc-900 p-3 sm:p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 shadow-sm mb-10 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        
        <!-- Tab Switcher: 3 Pilihan Terlihat Jelas, Tab Terpilih Berubah Warna Tanpa Outline Pink -->
        <div class="flex items-center gap-2 p-1.5 bg-zinc-100/90 dark:bg-zinc-800/90 rounded-2xl border border-zinc-200/90 dark:border-zinc-700/80 overflow-x-auto scrollbar-none" id="catalog-tab-switcher">
          <button
            type="button"
            data-tab="cuplikan"
            data-i18n="tabs.featured"
            class="tab-btn active px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 border border-zinc-900 dark:border-white shadow-sm"
          >
            {t(lang, 'tabs.featured')}
          </button>
          <button
            type="button"
            data-tab="pakaian"
            data-i18n="tabs.clothing"
            class="tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all whitespace-nowrap bg-white/80 dark:bg-zinc-900/60 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-50 dark:hover:bg-zinc-800"
          >
            {t(lang, 'tabs.clothing')}
          </button>
          <button
            type="button"
            data-tab="buket"
            data-i18n="tabs.bouquet"
            class="tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all whitespace-nowrap bg-white/80 dark:bg-zinc-900/60 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-50 dark:hover:bg-zinc-800"
          >
            {t(lang, 'tabs.bouquet')}
          </button>
        </div>

        <!-- Input Pencarian Global -->
        <div class="relative w-full md:w-80">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          <input
            type="search"
            id="global-catalog-search"
            placeholder={t(lang, 'search.placeholder')}
            data-i18n-placeholder="search.placeholder"
            class="w-full pl-10 pr-9 py-2.5 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/80 rounded-xl text-sm text-zinc-900 dark:text-white placeholder-zinc-400 focus:bg-white dark:focus:bg-zinc-900 focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none transition-all"
            autocomplete="off"
          />
          <button
            id="clear-search-btn"
            type="button"
            class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200"
            aria-label="Bersihkan pencarian"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

      </div>

      <!-- STATUS INDIKATOR HASIL PENCARIAN -->
      <div id="search-active-notice" class="hidden mb-6 flex items-center justify-between p-3.5 rounded-xl bg-zinc-100 dark:bg-zinc-850 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm">
        <div class="flex items-center gap-2 text-zinc-700 dark:text-zinc-300">
          <span data-i18n="search.showingResults">{t(lang, 'search.showingResults')}</span>
          <span id="search-query-display" class="font-bold text-zinc-900 dark:text-white"></span>
          <span id="search-count-display" class="text-zinc-500 font-normal"></span>
        </div>
        <button id="reset-search-link" type="button" class="text-brand-600 dark:text-brand-400 font-semibold hover:underline" data-i18n="search.reset">
          {t(lang, 'search.reset')}
        </button>
      </div>

      <!-- KONTEN TAB 1: [Cuplikan Pilihan] -->
      <div id="tab-content-cuplikan" class="tab-pane space-y-16">
        
        <!-- Seksi Cuplikan Pakaian Pilihan -->
        <div>
          <div class="flex items-center justify-between mb-8">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400" data-i18n="catalog.curatedPicks">
                {t(lang, 'catalog.curatedPicks')}
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white font-serif mt-1" data-i18n="catalog.featuredClothingTitle">
                {t(lang, 'catalog.featuredClothingTitle')}
              </h2>
            </div>
            <button
              type="button"
              onclick="window.switchCatalogTab('pakaian')"
              class="text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 hover:text-brand-600 dark:hover:text-brand-400 flex items-center gap-1 group py-1"
            >
              <span data-i18n="catalog.viewAllClothing">{t(lang, 'catalog.viewAllClothing')}</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4 sm:gap-6 catalog-items-container">
            {featuredPakaian.map((product) => (
              <div class="catalog-item" data-title={product.title} data-subcategory={product.sub_category} data-description={product.description || ''} data-category="pakaian">
                <ProductCard product={product} type="pakaian" lang={lang} />
              </div>
            ))}
          </div>
        </div>

        <!-- Seksi Cuplikan Buket Pilihan -->
        <div>
          <div class="flex items-center justify-between mb-8">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400" data-i18n="catalog.featuredPortfolio">
                {t(lang, 'catalog.featuredPortfolio')}
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white font-serif mt-1" data-i18n="catalog.featuredBouquetTitle">
                {t(lang, 'catalog.featuredBouquetTitle')}
              </h2>
            </div>
            <button
              type="button"
              onclick="window.switchCatalogTab('buket')"
              class="text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 hover:text-brand-600 dark:hover:text-brand-400 flex items-center gap-1 group py-1"
            >
              <span data-i18n="catalog.viewAllBouquet">{t(lang, 'catalog.viewAllBouquet')}</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4 sm:gap-6 catalog-items-container">
            {featuredBuket.map((product) => (
              <div class="catalog-item" data-title={product.title} data-subcategory={product.sub_category} data-description={product.description || ''} data-category="buket">
                <ProductCard product={product} type="buket" lang={lang} />
              </div>
            ))}
          </div>
        </div>

        <!-- Edukasi Buket SETELAH Galeri Buket Pilihan -->
        <div class="pt-4">
          <BouquetEducation />
        </div>

      </div>

      <!-- KONTEN TAB 2: [Galeri Pakaian] -->
      <div id="tab-content-pakaian" class="tab-pane hidden space-y-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-zinc-200/80 dark:border-zinc-800">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400" data-i18n="catalog.fullCatalog">
              {t(lang, 'catalog.fullCatalog')}
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white font-serif mt-1" data-i18n="catalog.clothingTitle">
              {t(lang, 'catalog.clothingTitle')}
            </h2>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1" data-i18n="catalog.clothingSubtitle">
              {t(lang, 'catalog.clothingSubtitle')}
            </p>
          </div>

          <!-- Filter Sub-Kategori Pakaian (Dinamis dari Supabase, tanpa kamus i18n) -->
          <div class="flex flex-wrap gap-1.5" id="pakaian-subcat-filters">
            <button
              type="button"
              data-subcat="all"
              data-i18n="categories.all"
              class="subcat-filter-btn active px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 transition-all shadow-2xs"
            >
              {t(lang, 'categories.all')}
            </button>
            {clothingTypes.map((subcat) => (
              <button
                type="button"
                data-subcat={subcat}
                class="subcat-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-white dark:bg-zinc-850 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 transition-all"
              >
                {subcat}
              </button>
            ))}
          </div>
        </div>

        <!-- Grid Semua Pakaian -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6 catalog-items-container" id="pakaian-full-grid">
          {allPakaian.map((product) => (
            <div class="catalog-item" data-title={product.title} data-subcategory={product.sub_category} data-description={product.description || ''} data-category="pakaian">
              <ProductCard product={product} type="pakaian" lang={lang} />
            </div>
          ))}
        </div>

      </div>

      <!-- KONTEN TAB 3: [Galeri Buket] -->
      <div id="tab-content-buket" class="tab-pane hidden space-y-10">
        
        <div class="pb-4 border-b border-zinc-200/80 dark:border-zinc-800">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400" data-i18n="catalog.creativePortfolio">
            {t(lang, 'catalog.creativePortfolio')}
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white font-serif mt-1" data-i18n="catalog.bouquetTitle">
            {t(lang, 'catalog.bouquetTitle')}
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1" data-i18n="catalog.bouquetSubtitle">
            {t(lang, 'catalog.bouquetSubtitle')}
          </p>
        </div>

        <!-- Grid Semua Buket -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6 catalog-items-container" id="buket-full-grid">
          {allBuket.map((product) => (
            <div class="catalog-item" data-title={product.title} data-subcategory={product.sub_category} data-description={product.description || ''} data-category="buket">
              <ProductCard product={product} type="buket" lang={lang} />
            </div>
          ))}
        </div>

        <!-- Kotak Informasi Fleksibilitas Harga Buket Tepat SETELAH Seksi Galeri Buket -->
        <div class="pt-6">
          <BouquetEducation />
        </div>

      </div>

      <!-- TAMPILAN TIDAK ADA HASIL PENCARIAN -->
      <div id="catalog-no-results" class="hidden text-center py-20 bg-white dark:bg-zinc-900 rounded-3xl border border-zinc-200 dark:border-zinc-800 mt-8">
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-400">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-zinc-900 dark:text-white" data-i18n="search.noResultsTitle">
          {t(lang, 'search.noResultsTitle')}
        </h3>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1 max-w-sm mx-auto" data-i18n="search.noResultsDesc">
          {t(lang, 'search.noResultsDesc')}
        </p>
        <button
          type="button"
          onclick="document.getElementById('global-catalog-search').value = ''; document.getElementById('global-catalog-search').dispatchEvent(new Event('input'));"
          class="mt-5 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 text-xs font-semibold hover:opacity-90 transition-opacity"
        >
          <span data-i18n="search.clearSearch">{t(lang, 'search.clearSearch')}</span>
        </button>
      </div>

    </div>
  </section>

  <!-- Seksi Informasi Toko Fisik & Lokasi -->
  <StoreInfo />

  <!-- Footer Elegan Charcoal -->
  <Footer />
  </div>

  <!-- Modal Pop-up Multi-Foto (Lightbox) -->
  <Lightbox />

  <!-- Tombol WhatsApp Mengambang (FAB) -->
  <WhatsAppFAB />
</BaseLayout>

<!-- Client Script: Tab Switcher, Pencarian Global & Efek Klik Berubah Warna pada Kartu Fitur -->
<script is:inline>
(function() {
  const switcher = document.getElementById('catalog-tab-switcher');
  const searchInput = document.getElementById('global-catalog-search');
  const clearBtn = document.getElementById('clear-search-btn');
  const noResultsBox = document.getElementById('catalog-no-results');
  const searchNotice = document.getElementById('search-active-notice');
  const searchQueryDisplay = document.getElementById('search-query-display');
  const searchCountDisplay = document.getElementById('search-count-display');
  const resetSearchLink = document.getElementById('reset-search-link');

  let activeTab = 'cuplikan'; // 'cuplikan' | 'pakaian' | 'buket'
  let activeSubcat = 'all';

  // Interaktivitas Kartu Fitur Toko: Berubah Warna Berbeda-beda Saat Diklik
  const featureCards = document.querySelectorAll('.feature-interactive-card');
  const colorThemes = {
    rose: {
      bg: 'bg-zinc-900 dark:bg-rose-50',
      border: 'border-rose-500 dark:border-rose-400',
      heading: 'text-rose-400 dark:text-rose-700',
      desc: 'text-rose-200/90 dark:text-rose-900/80'
    },
    purple: {
      bg: 'bg-zinc-900 dark:bg-purple-50',
      border: 'border-purple-500 dark:border-purple-400',
      heading: 'text-purple-400 dark:text-purple-700',
      desc: 'text-purple-200/90 dark:text-purple-900/80'
    },
    sky: {
      bg: 'bg-zinc-900 dark:bg-sky-50',
      border: 'border-sky-500 dark:border-sky-400',
      heading: 'text-sky-400 dark:text-sky-700',
      desc: 'text-sky-200/90 dark:text-sky-900/80'
    },
    emerald: {
      bg: 'bg-zinc-900 dark:bg-emerald-50',
      border: 'border-emerald-500 dark:border-emerald-400',
      heading: 'text-emerald-400 dark:text-emerald-700',
      desc: 'text-emerald-200/90 dark:text-emerald-900/80'
    }
  };

  featureCards.forEach((card) => {
    card.addEventListener('click', () => {
      const colorKey = card.dataset.featureColor;
      const theme = colorThemes[colorKey];
      if (!theme) return;

      const isAlreadyActive = card.dataset.active === 'true';

      // Reset semua kartu fitur terlebih dahulu
      featureCards.forEach(c => {
        c.dataset.active = 'false';
        c.className = 'feature-interactive-card bg-zinc-900 dark:bg-white border border-zinc-800 dark:border-white rounded-2xl p-4 sm:p-5 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300 cursor-pointer select-none text-center flex flex-col items-center justify-start h-full group';
        const h = c.querySelector('h3');
        const p = c.querySelector('p');
        if (h) h.className = 'font-bold text-white dark:text-zinc-900 text-sm sm:text-base tracking-tight transition-colors group-hover:text-zinc-200 dark:group-hover:text-zinc-700';
        if (p) p.className = 'text-xs sm:text-sm text-zinc-400 dark:text-zinc-600 mt-1.5 leading-relaxed font-normal';
      });

      // Jika belum aktif, aktifkan warna uniknya
      if (!isAlreadyActive) {
        card.dataset.active = 'true';
        card.className = `feature-interactive-card ${theme.bg} ${theme.border} border rounded-2xl p-4 sm:p-5 shadow-md scale-[1.02] -translate-y-1 transition-all duration-300 cursor-pointer select-none text-center flex flex-col items-center justify-start h-full group`;
        const h = card.querySelector('h3');
        const p = card.querySelector('p');
        if (h) h.className = `font-bold ${theme.heading} text-sm sm:text-base tracking-tight transition-colors`;
        if (p) p.className = `text-xs sm:text-sm ${theme.desc} mt-1.5 leading-relaxed font-normal`;
      }
    });
  });

  // Global function to switch tabs from header or hero buttons
  window.switchCatalogTab = function(tabName) {
    if (!['cuplikan', 'pakaian', 'buket'].includes(tabName)) return;
    activeTab = tabName;

    // Update Tab Buttons UI
    if (switcher) {
      const buttons = switcher.querySelectorAll('.tab-btn');
      buttons.forEach(btn => {
        if (btn.dataset.tab === tabName) {
          btn.className = 'tab-btn active px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 border border-zinc-900 dark:border-white shadow-sm';
        } else {
          btn.className = 'tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all whitespace-nowrap bg-white/80 dark:bg-zinc-900/60 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-50 dark:hover:bg-zinc-800';
        }
      });
    }

    // Toggle Tab Panes
    document.querySelectorAll('.tab-pane').forEach(pane => {
      pane.classList.add('hidden');
    });
    const currentPane = document.getElementById(`tab-content-${tabName}`);
    if (currentPane) {
      currentPane.classList.remove('hidden');
    }

    // Re-apply filter & search
    filterCurrentView();
  };

  // Click on Tab switcher buttons
  switcher?.addEventListener('click', (e) => {
    const btn = e.target.closest('.tab-btn');
    if (!btn) return;
    window.switchCatalogTab(btn.dataset.tab);
  });

  // Filter Sub-kategori Pakaian
  const subcatFilters = document.getElementById('pakaian-subcat-filters');
  subcatFilters?.addEventListener('click', (e) => {
    const btn = e.target.closest('.subcat-filter-btn');
    if (!btn) return;
    activeSubcat = btn.dataset.subcat || 'all';

    subcatFilters.querySelectorAll('.subcat-filter-btn').forEach(b => {
      if (b === btn) {
        b.className = 'subcat-filter-btn active px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 transition-all shadow-2xs';
      } else {
        b.className = 'subcat-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-white dark:bg-zinc-850 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 transition-all';
      }
    });

    filterCurrentView();
  });

  // Real-time Global Search Input
  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim();
    if (query.length > 0) {
      clearBtn?.classList.remove('hidden');
    } else {
      clearBtn?.classList.add('hidden');
    }
    filterCurrentView();
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      clearBtn.classList.add('hidden');
      filterCurrentView();
      searchInput.focus();
    }
  });

  resetSearchLink?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      clearBtn?.classList.add('hidden');
      filterCurrentView();
    }
  });

  function filterCurrentView() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    const currentPane = document.getElementById(`tab-content-${activeTab}`);
    if (!currentPane) return;

    const items = currentPane.querySelectorAll('.catalog-item');
    let visibleCount = 0;

    items.forEach(item => {
      const title = (item.dataset.title || '').toLowerCase();
      const subcat = (item.dataset.subcategory || '').toLowerCase();
      const desc = (item.dataset.description || '').toLowerCase();

      // Check subcategory filter if in 'pakaian' tab
      let matchesSubcat = true;
      if (activeTab === 'pakaian' && activeSubcat !== 'all') {
        matchesSubcat = (subcat === activeSubcat.toLowerCase());
      }

      // Check search query
      let matchesQuery = true;
      if (query.length > 0) {
        matchesQuery = title.includes(query) || subcat.includes(query) || desc.includes(query);
      }

      if (matchesSubcat && matchesQuery) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    // Handle No Results State
    if (visibleCount === 0) {
      noResultsBox?.classList.remove('hidden');
    } else {
      noResultsBox?.classList.add('hidden');
    }

    // Update Search notice info
    if (query.length > 0) {
      searchNotice?.classList.remove('hidden');
      if (searchQueryDisplay) searchQueryDisplay.textContent = `"${query}"`;
      const currentLang = localStorage.getItem('lang') || document.documentElement.lang || 'id';
      const foundLabel = window.getI18nText ? window.getI18nText('search.productsFound', currentLang) : 'produk ditemukan';
      if (searchCountDisplay) searchCountDisplay.textContent = `(${visibleCount} ${foundLabel})`;
    } else {
      searchNotice?.classList.add('hidden');
    }
  }

  // Update count jika bahasa berubah saat search aktif
  window.addEventListener('app:language-change', () => {
    filterCurrentView();
  });

  // Initial check on load
  filterCurrentView();
})();
</script>
