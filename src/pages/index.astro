<!-- Client Script: Tab Switcher, Pencarian Global, View Mode Toggle & Limitless Infinite Carousel -->
<script is:inline>
(function() {
  const katalogUtama = document.getElementById('katalog-utama');
  const switcher = document.getElementById('catalog-tab-switcher');
  const searchInput = document.getElementById('global-catalog-search');
  const clearBtn = document.getElementById('clear-search-btn');
  const noResultsBox = document.getElementById('catalog-no-results');
  const searchNotice = document.getElementById('search-active-notice');
  const searchQueryDisplay = document.getElementById('search-query-display');
  const searchCountDisplay = document.getElementById('search-count-display');
  const resetSearchLink = document.getElementById('reset-search-link');

  const viewModeSwipeBtn = document.getElementById('view-mode-swipe-btn');
  const viewModeGridBtn = document.getElementById('view-mode-grid-btn');

  let activeTab = 'cuplikan'; // 'cuplikan' | 'pakaian' | 'buket'
  let activeSubcat = 'all';

  // 1. Mode Geser sebagai DEFAULT UTAMA saat membuka web app Galeri Tik
  let currentViewMode = 'swipe';
  try {
    const sessionSaved = sessionStorage.getItem('catalog_view_mode');
    if (sessionSaved === 'grid') {
      currentViewMode = 'grid';
    } else {
      currentViewMode = 'swipe';
      localStorage.setItem('catalog_view_mode', 'swipe');
    }
  } catch (e) {
    currentViewMode = 'swipe';
  }

  function setViewMode(mode) {
    currentViewMode = mode;
    try {
      sessionStorage.setItem('catalog_view_mode', mode);
      localStorage.setItem('catalog_view_mode', mode);
    } catch (e) {}

    if (katalogUtama) {
      katalogUtama.dataset.viewMode = mode;
    }

    if (mode === 'swipe') {
      if (viewModeSwipeBtn) {
        viewModeSwipeBtn.className = 'view-mode-btn active inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 border border-zinc-900 dark:border-white shadow-2xs';
      }
      if (viewModeGridBtn) {
        viewModeGridBtn.className = 'view-mode-btn inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all whitespace-nowrap text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white border border-transparent';
      }
      setTimeout(() => {
        initAllInfiniteCarousels();
        updateAllSwipeDepths();
      }, 50);
    } else {
      if (viewModeGridBtn) {
        viewModeGridBtn.className = 'view-mode-btn active inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 border border-zinc-900 dark:border-white shadow-2xs';
      }
      if (viewModeSwipeBtn) {
        viewModeSwipeBtn.className = 'view-mode-btn inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all whitespace-nowrap text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white border border-transparent';
      }
    }
  }

  // Terapkan view mode awal (default swipe)
  setViewMode(currentViewMode);

  viewModeSwipeBtn?.addEventListener('click', () => setViewMode('swipe'));
  viewModeGridBtn?.addEventListener('click', () => setViewMode('grid'));

  // 2. Limitless / Infinite Loop Carousel Implementation
  function setupInfiniteLoop(container) {
    if (!container || container.dataset.infiniteInit === 'true') return;
    const originalItems = Array.from(container.querySelectorAll('.catalog-item:not([data-clone])'));
    if (originalItems.length < 2) return;

    container.dataset.infiniteInit = 'true';

    // Clone items untuk buffer sebelum (prepend) dan setelah (append)
    const clonesBefore = [];
    const clonesAfter = [];

    originalItems.forEach((item, idx) => {
      // Clone untuk setelah item terakhir (loop kembali ke awal)
      const cloneAfter = item.cloneNode(true);
      cloneAfter.setAttribute('data-clone', 'true');
      cloneAfter.setAttribute('data-original-index', idx);
      cloneAfter.classList.add('catalog-item-clone', 'catalog-item-clone-after');
      clonesAfter.push(cloneAfter);

      // Clone untuk sebelum item pertama (loop mundur ke akhir)
      const cloneBefore = item.cloneNode(true);
      cloneBefore.setAttribute('data-clone', 'true');
      cloneBefore.setAttribute('data-original-index', idx);
      cloneBefore.classList.add('catalog-item-clone', 'catalog-item-clone-before');
      clonesBefore.push(cloneBefore);
    });

    // Sisipkan clonesBefore sebelum item pertama
    clonesBefore.forEach(clone => {
      container.insertBefore(clone, originalItems[0]);
    });

    // Sisipkan clonesAfter setelah item terakhir
    clonesAfter.forEach(clone => {
      container.appendChild(clone);
    });

    // Menghitung setSpan = jarak horizontal 1 putaran penuh produk asli
    function getSetSpan() {
      const firstOrig = originalItems[0];
      const firstCloneAfter = clonesAfter[0];
      if (firstOrig && firstCloneAfter) {
        return firstCloneAfter.offsetLeft - firstOrig.offsetLeft;
      }
      return 0;
    }

    // Mengatur posisi scroll awal ke produk asli pertama
    function resetToStart(smooth = false) {
      if (katalogUtama && katalogUtama.dataset.viewMode !== 'swipe') return;
      const isMobile = window.innerWidth < 768;
      const firstOrig = originalItems[0];
      if (!firstOrig) return;

      let target = firstOrig.offsetLeft;
      if (isMobile) {
        target = firstOrig.offsetLeft - (container.clientWidth - firstOrig.clientWidth) / 2;
      }
      container.scrollTo({ left: Math.max(0, target), behavior: smooth ? 'smooth' : 'instant' });
    }

    // Teleport mulus tanpa kedip saat melintasi batas produk
    function checkInfiniteJump() {
      if (!katalogUtama || katalogUtama.dataset.viewMode !== 'swipe') return;
      // Jangan melompat jika filter pencarian aktif
      const firstClone = container.querySelector('.catalog-item-clone');
      if (firstClone && firstClone.style.display === 'none') return;

      const setSpan = getSetSpan();
      if (setSpan <= 0) return;

      const firstOrig = originalItems[0];
      if (!firstOrig) return;

      const isMobile = window.innerWidth < 768;
      const centerOffset = isMobile ? (container.clientWidth - firstOrig.clientWidth) / 2 : 0;
      const origBase = firstOrig.offsetLeft - centerOffset;

      // Jika digeser terus ke kanan melewati produk terakhir ke clonesAfter: teleport kembali ke awal produk asli
      if (container.scrollLeft >= origBase + setSpan - 15) {
        container.scrollLeft -= setSpan;
        if (isMobile) updateContainerDepth(container);
      } 
      // Jika digeser terus ke kiri melewati produk pertama ke clonesBefore: teleport ke produk asli akhir
      else if (container.scrollLeft <= origBase - 15) {
        container.scrollLeft += setSpan;
        if (isMobile) updateContainerDepth(container);
      }
    }

    container._resetToStart = resetToStart;
    container._checkInfiniteJump = checkInfiniteJump;

    // Listener scroll dengan debounce & scrollend
    let jumpTimer = null;
    container.addEventListener('scroll', () => {
      clearTimeout(jumpTimer);
      jumpTimer = setTimeout(checkInfiniteJump, 60);
    }, { passive: true });

    if ('onscrollend' in window) {
      container.addEventListener('scrollend', checkInfiniteJump, { passive: true });
    }

    // Posisikan ke awal produk asli
    setTimeout(() => {
      resetToStart(false);
      updateContainerDepth(container);
    }, 80);
  }

  function initAllInfiniteCarousels() {
    const containers = document.querySelectorAll('.catalog-items-container');
    containers.forEach(setupInfiniteLoop);
  }

  // Efek Kedalaman Dinamis di HP untuk Mode Geser (Interactive Carousel Depth)
  function updateContainerDepth(container) {
    if (!container || window.innerWidth >= 768) return;
    const rect = container.getBoundingClientRect();
    const containerCenter = rect.left + rect.width / 2;
    const items = container.querySelectorAll('.catalog-item');

    let closestItem = null;
    let minDistance = Infinity;

    items.forEach(item => {
      if (item.style.display === 'none') return;
      const itemRect = item.getBoundingClientRect();
      const itemCenter = itemRect.left + itemRect.width / 2;
      const distance = Math.abs(containerCenter - itemCenter);
      if (distance < minDistance) {
        minDistance = distance;
        closestItem = item;
      }
    });

    items.forEach(item => {
      if (item === closestItem) {
        item.classList.add('is-active-card');
      } else {
        item.classList.remove('is-active-card');
      }
    });
  }

  function updateAllSwipeDepths() {
    if (!katalogUtama || katalogUtama.dataset.viewMode !== 'swipe') return;
    const containers = katalogUtama.querySelectorAll('.catalog-items-container');
    containers.forEach(c => updateContainerDepth(c));
  }

  // Scroll listener dengan requestAnimationFrame untuk performa native 60fps
  const catalogContainers = document.querySelectorAll('.catalog-items-container');
  catalogContainers.forEach(container => {
    let ticking = false;
    container.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          if (katalogUtama && katalogUtama.dataset.viewMode === 'swipe') {
            updateContainerDepth(container);
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  });

  // Tombol Panah Navigasi Carousel di Desktop (Mendukung Limitless Looping)
  const carouselSections = document.querySelectorAll('.carousel-section');
  carouselSections.forEach(section => {
    const container = section.querySelector('.catalog-items-container');
    const prevBtn = section.querySelector('.carousel-prev-btn');
    const nextBtn = section.querySelector('.carousel-next-btn');

    if (container && prevBtn) {
      prevBtn.addEventListener('click', () => {
        const scrollDistance = container.clientWidth * 0.75;
        container.scrollBy({ left: -scrollDistance, behavior: 'smooth' });
        setTimeout(() => {
          if (container._checkInfiniteJump) container._checkInfiniteJump();
        }, 340);
      });
    }
    if (container && nextBtn) {
      nextBtn.addEventListener('click', () => {
        const scrollDistance = container.clientWidth * 0.75;
        container.scrollBy({ left: scrollDistance, behavior: 'smooth' });
        setTimeout(() => {
          if (container._checkInfiniteJump) container._checkInfiniteJump();
        }, 340);
      });
    }
  });

  window.addEventListener('resize', () => {
    if (katalogUtama && katalogUtama.dataset.viewMode === 'swipe') {
      updateAllSwipeDepths();
    }
  });

  // Interaktivitas Kartu Fitur Toko: Berubah Warna Berbeda-beda Saat Diklik
  const featureCards = document.querySelectorAll('.feature-interactive-card');
  const colorThemes = {
    rose: {
      bg: 'bg-zinc-900 dark:bg-rose-50',
      border: 'border-rose-500 dark:border-rose-400',
      heading: 'text-rose-400 dark:text-rose-700',
      desc: 'text-rose-200/90 dark:text-rose-900/80'
    },
    purple: {
      bg: 'bg-zinc-900 dark:bg-purple-50',
      border: 'border-purple-500 dark:border-purple-400',
      heading: 'text-purple-400 dark:text-purple-700',
      desc: 'text-purple-200/90 dark:text-purple-900/80'
    },
    sky: {
      bg: 'bg-zinc-900 dark:bg-sky-50',
      border: 'border-sky-500 dark:border-sky-400',
      heading: 'text-sky-400 dark:text-sky-700',
      desc: 'text-sky-200/90 dark:text-sky-900/80'
    },
    emerald: {
      bg: 'bg-zinc-900 dark:bg-emerald-50',
      border: 'border-emerald-500 dark:border-emerald-400',
      heading: 'text-emerald-400 dark:text-emerald-700',
      desc: 'text-emerald-200/90 dark:text-emerald-900/80'
    }
  };

  featureCards.forEach((card) => {
    card.addEventListener('click', () => {
      const colorKey = card.dataset.featureColor;
      const theme = colorThemes[colorKey];
      if (!theme) return;

      const isAlreadyActive = card.dataset.active === 'true';

      // Reset semua kartu fitur terlebih dahulu
      featureCards.forEach(c => {
        c.dataset.active = 'false';
        c.className = 'feature-interactive-card bg-zinc-900 dark:bg-white border border-zinc-800 dark:border-white rounded-2xl p-4 sm:p-5 shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300 cursor-pointer select-none text-center flex flex-col items-center justify-start h-full group';
        const h = c.querySelector('h3');
        const p = c.querySelector('p');
        if (h) h.className = 'font-bold text-white dark:text-zinc-900 text-sm sm:text-base tracking-tight transition-colors group-hover:text-zinc-200 dark:group-hover:text-zinc-700';
        if (p) p.className = 'text-xs sm:text-sm text-zinc-400 dark:text-zinc-600 mt-1.5 leading-relaxed font-normal';
      });

      // Jika belum aktif, aktifkan warna uniknya
      if (!isAlreadyActive) {
        card.dataset.active = 'true';
        card.className = `feature-interactive-card ${theme.bg} ${theme.border} border rounded-2xl p-4 sm:p-5 shadow-md scale-[1.02] -translate-y-1 transition-all duration-300 cursor-pointer select-none text-center flex flex-col items-center justify-start h-full group`;
        const h = card.querySelector('h3');
        const p = card.querySelector('p');
        if (h) h.className = `font-bold ${theme.heading} text-sm sm:text-base tracking-tight transition-colors`;
        if (p) p.className = `text-xs sm:text-sm ${theme.desc} mt-1.5 leading-relaxed font-normal`;
      }
    });
  });

  // Global function to switch tabs from header or hero buttons
  window.switchCatalogTab = function(tabName) {
    if (!['cuplikan', 'pakaian', 'buket'].includes(tabName)) return;
    activeTab = tabName;

    // Update Tab Buttons UI
    if (switcher) {
      const buttons = switcher.querySelectorAll('.tab-btn');
      buttons.forEach(btn => {
        if (btn.dataset.tab === tabName) {
          btn.className = 'tab-btn active px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all whitespace-nowrap bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 border border-zinc-900 dark:border-white shadow-sm';
        } else {
          btn.className = 'tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all whitespace-nowrap bg-white/80 dark:bg-zinc-900/60 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-50 dark:hover:bg-zinc-800';
        }
      });
    }

    // Toggle Tab Panes
    document.querySelectorAll('.tab-pane').forEach(pane => {
      pane.classList.add('hidden');
    });
    const currentPane = document.getElementById(`tab-content-${tabName}`);
    if (currentPane) {
      currentPane.classList.remove('hidden');
    }

    // Re-apply filter & search
    filterCurrentView();

    // Re-align carousels in newly visible tab
    setTimeout(() => {
      if (currentPane) {
        currentPane.querySelectorAll('.catalog-items-container').forEach(c => {
          setupInfiniteLoop(c);
          if (c._resetToStart) c._resetToStart(false);
          updateContainerDepth(c);
        });
      }
    }, 60);
  };

  // Click on Tab switcher buttons
  switcher?.addEventListener('click', (e) => {
    const btn = e.target.closest('.tab-btn');
    if (!btn) return;
    window.switchCatalogTab(btn.dataset.tab);
  });

  // 3. Filter Sub-kategori Pakaian (High-Contrast Styling in Dark Mode)
  const subcatFilters = document.getElementById('pakaian-subcat-filters');
  subcatFilters?.addEventListener('click', (e) => {
    const btn = e.target.closest('.subcat-filter-btn');
    if (!btn) return;
    activeSubcat = btn.dataset.subcat || 'all';

    subcatFilters.querySelectorAll('.subcat-filter-btn').forEach(b => {
      if (b === btn) {
        b.className = 'subcat-filter-btn active px-3.5 py-1.5 rounded-lg text-xs font-bold bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 border border-zinc-900 dark:border-white transition-all shadow-xs';
      } else {
        b.className = 'subcat-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-zinc-800 text-zinc-800 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 hover:border-zinc-400 dark:hover:border-zinc-500 hover:bg-zinc-50 dark:hover:bg-zinc-700 hover:text-zinc-900 dark:hover:text-white transition-all shadow-xs';
      }
    });

    filterCurrentView();
  });

  // Real-time Global Search Input
  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim();
    if (query.length > 0) {
      clearBtn?.classList.remove('hidden');
    } else {
      clearBtn?.classList.add('hidden');
    }
    filterCurrentView();
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      clearBtn.classList.add('hidden');
      filterCurrentView();
      searchInput.focus();
    }
  });

  resetSearchLink?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      clearBtn?.classList.add('hidden');
      filterCurrentView();
    }
  });

  function filterCurrentView() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    const isFiltered = query.length > 0 || (activeTab === 'pakaian' && activeSubcat !== 'all');
    const currentPane = document.getElementById(`tab-content-${activeTab}`);
    if (!currentPane) return;

    // Toggle visibility of clones during search/filter
    const clones = currentPane.querySelectorAll('.catalog-item-clone');
    clones.forEach(c => {
      c.style.display = isFiltered ? 'none' : '';
    });

    // Filter only genuine original items
    const originalItems = currentPane.querySelectorAll('.catalog-item:not([data-clone])');
    let visibleCount = 0;

    originalItems.forEach(item => {
      const title = (item.dataset.title || '').toLowerCase();
      const subcat = (item.dataset.subcategory || '').toLowerCase();
      const desc = (item.dataset.description || '').toLowerCase();

      // Check subcategory filter if in 'pakaian' tab
      let matchesSubcat = true;
      if (activeTab === 'pakaian' && activeSubcat !== 'all') {
        matchesSubcat = (subcat === activeSubcat.toLowerCase());
      }

      // Check search query
      let matchesQuery = true;
      if (query.length > 0) {
        matchesQuery = title.includes(query) || subcat.includes(query) || desc.includes(query);
      }

      if (matchesSubcat && matchesQuery) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    // Handle No Results State
    if (visibleCount === 0) {
      noResultsBox?.classList.remove('hidden');
    } else {
      noResultsBox?.classList.add('hidden');
    }

    // Update Search notice info
    if (query.length > 0) {
      searchNotice?.classList.remove('hidden');
      if (searchQueryDisplay) searchQueryDisplay.textContent = `"${query}"`;
      const currentLang = localStorage.getItem('lang') || document.documentElement.lang || 'id';
      const foundLabel = window.getI18nText ? window.getI18nText('search.productsFound', currentLang) : 'produk ditemukan';
      if (searchCountDisplay) searchCountDisplay.textContent = `(${visibleCount} ${foundLabel})`;
    } else {
      searchNotice?.classList.add('hidden');
    }

    // Update dynamic depth for visible items in swipe mode
    if (katalogUtama && katalogUtama.dataset.viewMode === 'swipe') {
      setTimeout(updateAllSwipeDepths, 40);
    }
  }

  // Update count jika bahasa berubah saat search aktif
  window.addEventListener('app:language-change', () => {
    filterCurrentView();
  });

  // Initial setup on load
  filterCurrentView();
  initAllInfiniteCarousels();
  setTimeout(updateAllSwipeDepths, 120);
})();
</script>

