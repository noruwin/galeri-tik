---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SearchBar from '../components/SearchBar.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import ProductCard from '../components/ProductCard.astro';
import WhatsAppFAB from '../components/WhatsAppFAB.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { supabase } from '../lib/supabase';
import { getLangFromCookie, t } from '../i18n';
import { SUB_CATEGORIES_PAKAIAN } from '../lib/constants';

const lang = getLangFromCookie(Astro.request.headers.get('cookie'));

// Fetch pakaian category
const { data: categories } = await supabase
  .from('categories')
  .select('*')
  .eq('slug', 'pakaian')
  .single();

// Fetch all pakaian products
const { data: products } = await supabase
  .from('products')
  .select('*')
  .eq('category_id', categories?.id || '')
  .order('created_at', { ascending: false });

const allProducts = products || [];
---

<BaseLayout title={`Koleksi Pakaian — Galeri Tik`} description="Koleksi busana pilihan di Galeri Tik. Gamis, daster, kulot, rok, celana, koko, kemeja, kaos, tas, dan bros.">
  <Header />

  <main class="min-h-screen pb-16">
    <!-- Page Header (Tanpa Emoji) Terikat i18n -->
    <section class="bg-gradient-to-b from-pink-50/40 to-slate-50/50 dark:from-zinc-950 dark:to-zinc-900/60 pt-10 pb-8 border-b border-zinc-200/60 dark:border-zinc-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex items-center gap-2 text-xs font-medium text-zinc-500 dark:text-zinc-400 mb-4">
          <a href="/" data-i18n="nav.home" class="hover:text-brand-600 transition-colors">{t(lang, 'nav.home')}</a>
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <span class="text-zinc-900 dark:text-white font-semibold" data-i18n="nav.clothing">{t(lang, 'nav.clothing')}</span>
        </div>

        <div class="max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400" data-i18n="catalog.fullCatalog">
            {t(lang, 'catalog.fullCatalog')}
          </span>
          <h1 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white mt-1 mb-3 font-serif tracking-tight" data-i18n="catalog.clothingTitle">
            {t(lang, 'catalog.clothingTitle')}
          </h1>
          <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed font-normal" data-i18n="catalog.clothingSubtitle">
            {t(lang, 'catalog.clothingSubtitle')}
          </p>
        </div>

        <!-- Search & Sub-kategori Filter -->
        <div class="mt-8 flex flex-col gap-4">
          <SearchBar placeholder={t(lang, 'search.placeholder')} />
          <CategoryFilter categories={SUB_CATEGORIES_PAKAIAN} />
        </div>

      </div>
    </section>

    <!-- Product Grid -->
    <section class="py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div id="product-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6">
          {allProducts.map((product) => (
            <div data-sub-category={product.sub_category} data-title={product.title} data-description={product.description || ''}>
              <ProductCard product={product} type="pakaian" lang={lang} />
            </div>
          ))}
        </div>

        <!-- No Results State -->
        <div id="no-results" class="hidden text-center py-20 bg-white dark:bg-zinc-900 rounded-3xl border border-zinc-200 dark:border-zinc-800 mt-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-400">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-zinc-900 dark:text-white" data-i18n="search.noResultsTitle">{t(lang, 'search.noResultsTitle')}</h3>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1" data-i18n="search.noResultsDesc">{t(lang, 'search.noResultsDesc')}</p>
        </div>

        <!-- Empty state jika data belum ada -->
        {allProducts.length === 0 && (
          <div class="text-center py-20">
            <p class="text-base font-semibold text-zinc-800 dark:text-zinc-200" data-i18n="search.noResultsTitle">Koleksi pakaian sedang dipersiapkan.</p>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
  <Lightbox />
  <WhatsAppFAB />
</BaseLayout>

<script is:inline>
(function() {
  const searchInput = document.getElementById('search-input');
  const grid = document.getElementById('product-grid');
  const noResults = document.getElementById('no-results');

  if (!searchInput || !grid) return;

  searchInput.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    const cards = grid.querySelectorAll('[data-sub-category]');

    cards.forEach(card => {
      const title = (card.dataset.title || '').toLowerCase();
      const desc = (card.dataset.description || '').toLowerCase();
      const subCat = (card.dataset.subCategory || '').toLowerCase();

      if (!query || title.includes(query) || desc.includes(query) || subCat.includes(query)) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });

    const visibleCards = grid.querySelectorAll('[data-sub-category]:not([style*="display: none"])');
    if (noResults) {
      noResults.style.display = visibleCards.length === 0 ? 'block' : 'none';
    }
  });
})();
</script>
